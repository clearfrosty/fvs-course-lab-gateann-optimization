+  // Returns a cheap upper bound on subset selectivity. For a single-label
+  // query this is exact; for multiple labels the rarest marginal frequency
+  // is an upper bound and is sufficient to decide whether special routing is
+  // warranted.
+  float estimate_selectivity(const void *filter_data) const {
+    if (!filter_data || n_nodes_ == 0) return 1.0f;
+    uint32_t q_count;
+    memcpy(&q_count, filter_data, sizeof(uint32_t));
+    if (q_count == 0) return 1.0f;
+    const uint32_t *q_labels =
+        (const uint32_t *)((const char *)filter_data + sizeof(uint32_t));
+    uint32_t rarest = n_nodes_;
+    for (uint32_t i = 0; i < q_count; ++i) {
+      const uint32_t label = q_labels[i];
+      const uint32_t count = label < label_counts_.size() ? label_counts_[label] : 0;
+      rarest = std::min(rarest, count);
+    }
+    return static_cast<float>(rarest) / static_cast<float>(n_nodes_);
+  }
